# Expo inlines EXPO_PUBLIC_* at build time (same "not secret, ends up in
# the bundle regardless" reasoning as vea-frontend's VITE_API_URL).
#
# localhost works for the iOS simulator and Expo web. Android emulator
# needs 10.0.2.2 instead of localhost. A physical device needs the dev
# machine's LAN IP (e.g. 192.168.x.x) since it can't resolve "localhost"
# to your computer.
EXPO_PUBLIC_API_URL="http://localhost:3000"
